:root{--bg:#F2F4F8;--surface:#fff;--ink:#101828;--muted:#566074;--line:#D8DEE9;--accent:#2B50FF;--accent-ink:#fff;--code:#0E1626;
--display:'Bricolage Grotesque','Trebuchet MS',sans-serif;--body:'Instrument Sans','Segoe UI',system-ui,sans-serif;--mono:'JetBrains Mono',Consolas,monospace}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth;scroll-padding-top:5rem}
body{background:var(--bg);color:var(--ink);font:400 1.0625rem/1.65 var(--body);-webkit-font-smoothing:antialiased}
a{color:inherit}
h1,h2,h3{font-family:var(--display);line-height:1.1;letter-spacing:-.02em}
h1{font-size:clamp(2.4rem,6vw,4.4rem);font-weight:800}
h2{font-size:clamp(1.8rem,3.5vw,2.6rem);font-weight:700;margin-bottom:.5rem}
h3{font-size:1.25rem;font-weight:700}
section,.top,footer{padding-inline:max(1.25rem,calc((100% - 1100px)/2))}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
.skip{position:absolute;left:-999px}.skip:focus{left:1rem;top:1rem;background:#fff;padding:.5rem 1rem;z-index:20}

.top{position:sticky;top:0;z-index:10;display:flex;justify-content:space-between;align-items:center;padding-block:.9rem;background:rgba(242,244,248,.9);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.logo{font:800 1.4rem var(--display);text-decoration:none}
nav{display:flex;align-items:center;gap:1.6rem}
nav a{text-decoration:none;font-weight:500}nav a:not(.btn):hover{color:var(--accent)}
.menu{display:none;background:none;border:1px solid var(--line);border-radius:8px;padding:.4rem .9rem;font:inherit;cursor:pointer}

.btn{display:inline-block;background:var(--accent);color:var(--accent-ink);padding:.85rem 1.5rem;border-radius:10px;font:600 1rem var(--body);text-decoration:none;border:2px solid var(--accent);cursor:pointer;transition:transform .15s,background .15s}
.btn:hover{transform:translateY(-2px);background:#1a3de0}
.btn.ghost{background:transparent;color:var(--ink);border-color:var(--ink)}.btn.ghost:hover{background:var(--ink);color:#fff}
.btn.small{padding:.5rem 1.1rem}

.hero{display:grid;grid-template-columns:1.1fr .9fr;gap:3rem;align-items:center;padding-block:5rem 4rem}
.lead{font-size:1.2rem;color:var(--muted);max-width:34rem;margin:1.4rem 0 2rem}
.cta{display:flex;gap:.8rem;flex-wrap:wrap}
.term{background:var(--code);border-radius:14px;box-shadow:0 24px 60px -20px rgba(16,24,40,.45);overflow:hidden}
.term-bar{display:flex;align-items:center;gap:.4rem;padding:.7rem 1rem;background:#17213a}
.term-bar i{width:11px;height:11px;border-radius:50%;background:#3a4668}
.term-bar span{margin-left:.8rem;font:.8rem var(--mono);color:#8c9ac0}
#code{padding:1.3rem 1.4rem;min-height:19rem;font:.92rem/1.7 var(--mono);color:#dbe4ff;white-space:pre-wrap}
#code .k{color:#7fa2ff}#code .s{color:#8be0b0}#code .c{color:#6b7aa6}
#code::after{content:"";display:inline-block;width:.55ch;height:1.1em;background:#7fa2ff;vertical-align:-.2em;animation:blink 1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}

.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem;padding-block:2rem;border-block:1px solid var(--line)}
.stats p{color:var(--muted);font-size:.95rem;line-height:1.4}
.stats b{display:block;font:800 2rem var(--display);color:var(--ink)}

.work,.process,.about,.contact{padding-block:5rem}
.sub{color:var(--muted);margin-bottom:2rem}
.work ul{list-style:none;padding:0}
.proj{display:grid;grid-template-columns:minmax(220px,340px) 1fr;gap:2rem;align-items:center;text-decoration:none;padding:1.5rem 0;border-top:1px solid var(--line)}
.work li:last-child .proj{border-bottom:1px solid var(--line)}
.proj p{color:var(--muted);margin:.5rem 0}
.proj small{font:.85rem var(--mono);color:var(--accent)}
.thumb{aspect-ratio:16/10;border-radius:12px;display:flex;align-items:flex-end;padding:1rem;color:#fff;font:700 1.1rem var(--display);transition:transform .25s}
.proj:hover .thumb{transform:scale(1.02)}.proj:hover h3{color:var(--accent)}
.t1{background:linear-gradient(135deg,#2B50FF,#101828)}
.t2{background:linear-gradient(135deg,#E2572B,#7a1f3d)}
.t3{background:linear-gradient(135deg,#0f8a6d,#0E1626)}

.process{background:var(--surface);margin-inline:0;padding-inline:max(1.25rem,calc((100% - 1100px)/2))}
.process ol{list-style:none;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:2rem;counter-reset:s;margin-top:2rem}
.process li{counter-increment:s;border-top:3px solid var(--ink);padding-top:1rem}
.process li::before{content:counter(s);font:800 1.6rem var(--display);color:var(--accent)}
.process p{color:var(--muted);margin-top:.5rem}

.about{display:grid;grid-template-columns:.8fr 1.2fr;gap:3.5rem;align-items:center}
.about p{margin-top:1rem;max-width:38rem}
.photo{aspect-ratio:4/5;border-radius:16px;overflow:hidden;background:linear-gradient(160deg,#f6a65a,#2B50FF 70%,#101828)}
.photo img{width:100%;height:100%;object-fit:cover;display:block}
.photo.empty img{display:none}
.skills{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.5rem}
.skills li{border:1px solid var(--line);background:var(--surface);padding:.3rem .9rem;border-radius:99px;font-size:.92rem}

.contact{background:var(--ink);color:#fff;max-width:none}
.contact .sub{color:#aab4cc}
form{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem;max-width:44rem}
label{display:grid;gap:.4rem;font-weight:500;font-size:.95rem}.full{grid-column:1/-1}
input,textarea{font:inherit;padding:.8rem 1rem;border-radius:10px;border:2px solid #34405f;background:#17213a;color:#fff}
input:focus,textarea:focus{border-color:#7fa2ff;outline:none}
input.bad,textarea.bad{border-color:#ff8a7a}
form .btn{justify-self:start}
#status{grid-column:1/-1;min-height:1.5rem;color:#8be0b0}#status.err{color:#ffb0a4}
footer{padding-block:1.6rem;color:var(--muted);font-size:.9rem}

@media(max-width:860px){
 .hero,.about{grid-template-columns:1fr}
 .hero{padding-block:3rem}
 .stats,.process ol{grid-template-columns:1fr 1fr}
 .proj{grid-template-columns:1fr}
 .menu{display:block}
 nav{display:none;position:absolute;top:100%;left:0;right:0;flex-direction:column;align-items:flex-start;background:var(--bg);padding:1.2rem 1.25rem;border-bottom:1px solid var(--line)}
 nav.open{display:flex}
 form{grid-template-columns:1fr}
}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}
